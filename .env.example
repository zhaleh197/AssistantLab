# ---------- کلید سرویس‌های مدل زبانی (حداقل یکی) ----------
# Groq (سریع، پلن رایگان): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (برای Embedding لازم است؛ پشتیبان گفتگو): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# مدل‌های گفتگو به ترتیب اولویت («سرویس:مدل»). اگر یکی خطا بدهد یا در ۸ ثانیه شروع نکند، بعدی امتحان می‌شود.
# سرویس‌ها: groq، gemini، openai (OPENAI_API_KEY)، openrouter (OPENROUTER_API_KEY)
# برای آزمایش کلیدها و مدل‌ها: python scripts/check_models.py
# CHAT_MODELS=groq:qwen/qwen3.8-27b, groq:openai/gpt-oss-120b, gemini:gemini-3.5-flash
# میزان «فکر کردن» Gemini قبل از پاسخ؛ minimal سریع‌ترین است
# GEMINI_REASONING_EFFORT=minimal

# ---------- Embedding ----------
# بعد از افزودن منابع، مدل و ابعاد را عوض نکنید (منابع باید دوباره اضافه شوند)
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
# اگر خالی باشد از GEMINI_API_KEY استفاده می‌شود
EMBED_API_KEY=

# ---------- دیتابیس ----------
# خالی = SQLite محلی (پوشه‌ی data)
# برای Supabase: Connect → Session pooler (پورت 5432، نه 6543)؛ [YOUR-PASSWORD] را با رمز دیتابیس عوض کنید
DATABASE_URL=
# DB_SCHEMA=assistantlab
