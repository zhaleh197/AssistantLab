# کلید رایگان Gemini: https://aistudio.google.com/apikey
CHAT_API_KEY=

# مدل گفتگو (برای دیدن مدل‌های در دسترس: python scripts/check_models.py)
CHAT_MODEL=gemini-3.8-flash
CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# مدل Embedding — بعد از افزودن منابع عوضش نکنید (منابع باید دوباره اضافه شوند)
EMBED_MODEL=gemini-embedding-001
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# اگر خالی باشد از CHAT_API_KEY استفاده می‌شود
EMBED_API_KEY=
# ابعاد بردار؛ بعد از افزودن منابع عوضش نکنید
EMBED_DIMENSIONS=768

# دیتابیس: خالی = SQLite محلی (پوشه‌ی data)
# برای Supabase: Connect → Session pooler (پورت 5432، نه 6543)؛ [YOUR-PASSWORD] را با رمز دیتابیس عوض کنید
DATABASE_URL=
# DB_SCHEMA=assistantlab

# مثال استفاده از Groq برای گفتگو (Embedding همچنان با Gemini):
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_API_KEY=gsk_...
# CHAT_MODEL=llama-3.3-70b-versatile
# EMBED_API_KEY=<کلید Gemini>
